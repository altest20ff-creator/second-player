<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090C12">

    <RelativeLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مشغل الموسيقى"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/gridCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerBar"
        android:orientation="horizontal"
        android:weightSum="3"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnCatTracks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎵 المسارات"
            android:textColor="#FFB703"
            android:backgroundTint="#131A29"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCatFolders"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="📁 المجلدات"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131A29"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCatFavs"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="❤️ المفضلة"
            android:textColor="#FFFFFF"
            android:backgroundTint="#131A29"/>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/listHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/gridCategories"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvCurrentCategoryTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جميع المسارات الصوتية"
            android:textColor="#8F98B0"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 مسار"
            android:textColor="#FFB703"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/listHeader"
        android:layout_above="@id/bottomPlayerCard"
        android:padding="6dp"/>

    <RelativeLayout
        android:id="@+id/bottomPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="#131926"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBottomArt"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play"
            app:shapeAppearanceOverlay="@style/RoundedImageView"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivBottomArt"
            android:layout_toStartOf="@id/controls"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBottomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اختر مساراً للتشغيل"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvBottomArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="انقر لفتح المشغل الكامل"
                android:textColor="#8F98B0"
                android:textSize="12sp"
                android:maxLines="1"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageButton
                android:id="@+id/btnBottomPlayPause"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_play"
                android:tint="#FFB703"/>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>
