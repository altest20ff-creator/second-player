<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <TextView
        android:id="@+id/tvMainTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مشغل الموسيقى"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:id="@+id/categoryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvMainTitle"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="10dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnCategoryTracks"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🎵 المسارات"
            android:textColor="@color/accent_gold"
            android:backgroundTint="@color/card_bg"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCategoryFolders"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="📁 المجلدات"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/card_bg"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCategoryFavorites"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="❤️ المفضلة"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/card_bg"/>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/statsHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/categoryLayout"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSectionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جميع المسارات الصوتية"
            android:textColor="@color/text_muted"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvTrackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 مسار"
            android:textColor="@color/accent_gold"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/statsHeader"
        android:layout_above="@id/bottomBar"
        android:padding="8dp"/>

    <RelativeLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_alignParentBottom="true"
        android:background="@color/card_bg"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivBottomArt"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play"
            app:shapeAppearanceOverlay="@style/RoundedImageStyle"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivBottomArt"
            android:layout_toStartOf="@id/btnBottomPlay"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBottomTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اختر مساراً للتشغيل"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvBottomArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اضغط لفتح الشاشة الكاملة"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:maxLines="1"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBottomPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_play"
            android:tint="@color/accent_gold"/>
    </RelativeLayout>

</RelativeLayout>
