<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090C12">

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="مشغل الموسيقى"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:id="@+id/categoryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvHeaderTitle"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="8dp"
        android:weightSum="3">

        <Button
            android:id="@+id/btnCategoryTracks"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="🎵 المسارات"
            android:textSize="12sp"
            android:textColor="#FFB703"
            android:backgroundTint="#1B2232"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCategoryFolders"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="📁 المجلدات"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B2232"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnCategoryFavorites"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="❤️ المفضلة"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1B2232"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/categoryLayout"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="جميع المسارات الصوتية"
            android:textColor="#8F98B0"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvTrackCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 مسار"
            android:textColor="#FFB703"
            android:textSize="13sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/statsLayout"
        android:layout_above="@id/bottomPlayerCard"
        android:padding="8dp"/>

    <!-- Bottom Mini-Player Bar with HD Album Thumbnail -->
    <LinearLayout
        android:id="@+id/bottomPlayerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#131926"
        android:elevation="10dp">

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progressTint="#FFB703"
            android:thumbTint="#FFB703"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivBottomAlbumArt"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_alignParentStart="true"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_media_play"
                android:background="#1E2638"
                app:shapeAppearanceOverlay="@style/RoundedImageView"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/ivBottomAlbumArt"
                android:layout_toStartOf="@id/controlsLayout"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNowPlayingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="اختر مساراً للتشغيل"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvNowPlayingArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Second Player"
                    android:textColor="#8F98B0"
                    android:textSize="12sp"
                    android:maxLines="1"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/controlsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnPrevious"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⏮"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:text="⏯"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:backgroundTint="#FFB703"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⏭"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>
